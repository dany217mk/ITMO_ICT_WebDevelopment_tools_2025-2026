  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = Date.now().toString();",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('testEmail1', `user1-${runId}@test.com`);",
          "  pm.collectionVariables.set('testEmail2', `user2-${runId}@test.com`);",
          "  pm.collectionVariables.set('projectTitle', `Test Project ${runId}`);",
          "  pm.collectionVariables.set('teamName', `Test Team ${runId}`);",
          "}",
          "pm.collectionVariables.set('password', pm.collectionVariables.get('password') || 'Test12345');"
        ]
      }
    }
  ],
